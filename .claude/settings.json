{
  "permissions": {
    "allow": [
        "Bash(./vendor/bin/sail *)",
        "Bash(./vendor/bin/sail artisan *)",
        "Bash(git add *)",
        "Bash(git commit *)",
        "Bash(git push *)",
        "Bash(git checkout *)",
        "Bash(git branch *)",
        "Bash(git merge *)",
        "Bash(git log *)",
        "Bash(git diff *)",
        "Bash(git status)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in \"$PWD\"/*.php) ./vendor/bin/sail exec laravel.test ./vendor/bin/pint \"${f#$PWD/}\" ;; esac; } || true",
            "timeout": 60,
            "statusMessage": "Running Pint..."
          }
        ]
      }
    ]
  }
}
